# VRINDA AI — Server Environment Configuration
# Copy this file to .env and insert your Gemini API Key

# Your Google Gemini API Key (Get yours at https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# The Gemini model to use (Defaults to gemini-3.5-flash with automatic resilience fallback)
GEMINI_MODEL=gemini-3.5-flash

# Port for the Express server to listen on
PORT=3000
